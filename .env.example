# ───────── 사이트 ─────────
# 배포 도메인 (PayApp 결제 통보/리턴 URL 생성에 사용)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 세션/다운로드 토큰 서명용 비밀키 (32자 이상 랜덤 문자열)
APP_SECRET=change-me-to-a-long-random-string

# 관리자 로그인 비밀번호 (/admin)
ADMIN_PASSWORD=change-me

# ───────── Supabase ─────────
# 설정하지 않으면 로컬 데모 모드(.data/ 폴더 JSON 저장소)로 동작합니다.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 비공개 Storage 버킷 이름
SUPABASE_STORAGE_BUCKET=product-files

# ───────── PayApp ─────────
# 설정하지 않으면 모의 결제(데모) 화면으로 동작합니다.
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
# PayApp 미설정 상태에서 운영 빌드에 모의 결제를 켜려면 true (공개 사이트에서는 절대 사용 금지)
ENABLE_MOCK_PAYMENT=

# ───────── 이메일 (재접속 인증코드 발송) ─────────
# 설정하지 않으면 개발 모드에서 화면에 인증코드를 표시합니다.
RESEND_API_KEY=
MAIL_FROM="MIRACLE PROMPT <no-reply@example.com>"
